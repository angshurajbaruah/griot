{
  "manifest_version": 3,
  "name": "Griot",
  "description": "Your context lives on. Remembers where you left off, and keeps it on this device.",
  "version": "0.7.0",
  "permissions": [
    "tabs",
    "storage",
    "favicon",
    "idle",
    "tabGroups",
    "offscreen"
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "Griot",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "park-thread": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Park the thread you're on"
    }
  }
}
